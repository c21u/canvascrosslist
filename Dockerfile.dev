FROM node:lts
WORKDIR /app

COPY package.json .
COPY yarn.lock .

RUN yarn install --non-interactive --no-progress

COPY webpack.common.js .
COPY webpack.dev.js .
COPY client client
COPY server server

ARG app_version
ENV APP_VERSION=$app_version

EXPOSE 3000

USER node

ENTRYPOINT [ "yarn", "run" ]
CMD [ "develop" ]
